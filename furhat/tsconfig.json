{
  "compilerOptions": {
    "module": "Node16",
    "target": "es2016",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "lib": ["dom", "es2016"],
    "moduleResolution": "Node16"
  },
  "include": ["src/**/*.ts"]
}
